<?xml version="1.0" encoding="utf-8"?>
<!--
  仅 benchmark 构建生效。

  benchmark 是"开 R8 的真机冒烟包"，同样要连局域网上的明文开发服务器
  （http://<局域网IP>:3000），与 development 源集保持相同联调策略。

  网络策略与 development 共用生成任务，只放行私有配置中的 HTTP / WS 主机。

  release 不含这份清单：生产只走 HTTPS。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <application android:networkSecurityConfig="@xml/network_security_config">
        <!-- Performance tests require API 29; earlier development devices ignore this attribute. -->
        <profileable android:shell="true" tools:targetApi="q" />
        <activity android:name="com.custodysim.app.benchmark.ReaderBenchmarkActivity"
            android:exported="true" android:theme="@style/Theme.CustodySim" />
    </application>
</manifest>
